# Copy to .env.deploy and fill secrets before deploying:
#   copy .env.deploy.example .env.deploy

HTTP_PORT=80

POSTGRES_USER=wafer_yield
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=wafer_yield

JWT_SECRET=change-me-to-a-long-random-production-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
AUTH_DISABLED=false
LOG_LEVEL=INFO
STALE_TELEMETRY_SECONDS=45

CORS_ORIGINS=http://localhost,http://127.0.0.1
TELEMETRY_CHANNEL=test-floor.events

# Same-origin via nginx (recommended)
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_WS_URL=
